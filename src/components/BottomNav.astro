---
import { t } from "@/lib/i18n";

interface Props {
  currentPath: string;
  packBadge?: number;
}

const { currentPath, packBadge = 0 } = Astro.props;
const { locale } = Astro.locals;

const tabs = [
  {
    href: "/dashboard",
    label: t(locale, "nav.start"),
    exact: true,
  },
  {
    href: "/map",
    label: t(locale, "nav.map"),
    exact: false,
  },
  {
    href: "/meetings",
    label: t(locale, "nav.meetings"),
    exact: false,
  },
  {
    href: "/pack",
    label: t(locale, "nav.pack"),
    exact: false,
  },
  {
    href: "/calendar",
    label: t(locale, "nav.calendar"),
    exact: false,
  },
  {
    href: "/settings",
    label: t(locale, "nav.settings"),
    exact: false,
  },
] as const;

function isActive(href: string, exact: boolean): boolean {
  if (exact) return currentPath === href;
  return currentPath.startsWith(href);
}
---

<nav class="fixed bottom-0 left-0 right-0 z-50 flex h-[70px] items-center justify-around border-t border-border bg-card pb-[env(safe-area-inset-bottom,0px)] md:hidden">
  {tabs.map((tab) => {
    const active = isActive(tab.href, tab.exact);
    return (
      <a
        href={tab.href}
        class:list={[
          "card-interactive relative flex w-full flex-col items-center gap-0.5 px-2 py-1 transition-colors duration-150",
          active ? "text-primary" : "text-muted-foreground",
        ]}
        aria-current={active ? "page" : undefined}
      >
        {tab.href === "/pack" && packBadge > 0 && (
          <span
            class="bg-primary text-primary-foreground absolute right-1/2 top-0 flex h-4 min-w-4 translate-x-3 items-center justify-center rounded-full px-1 text-[10px] font-semibold leading-none"
            aria-label={t(locale, "nav.packBadgeAria")}
          >
            {packBadge}
          </span>
        )}
        {tab.href === "/dashboard" && (
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="m2.25 12 8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25"
            />
          </svg>
        )}
        {tab.href === "/map" && (
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M9 6.75V15m6-6v8.25m.503 3.498 4.875-2.437c.381-.19.622-.58.622-1.006V4.82c0-.836-.88-1.38-1.628-1.006l-3.869 1.934c-.317.159-.69.159-1.006 0L9.503 3.252a1.125 1.125 0 0 0-1.006 0L3.622 5.689C3.24 5.88 3 6.27 3 6.695V19.18c0 .836.88 1.38 1.628 1.006l3.869-1.934c.317-.159.69-.159 1.006 0l4.994 2.497c.317.158.69.158 1.006 0Z"
            />
          </svg>
        )}
        {tab.href === "/meetings" && (
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5"
            />
          </svg>
        )}
        {tab.href === "/pack" && (
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M5.5 8a2.5 2.5 0 1 1 1.9-4.13A2.5 2.5 0 1 1 9 7.3l6 6a2.5 2.5 0 1 1 1.6 4.2 2.5 2.5 0 1 1-4.2-1.6l-6-6A2.5 2.5 0 0 1 5.5 8Z" />
          </svg>
        )}
        {tab.href === "/calendar" && (
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M12 12.75h.008v.008H12v-.008ZM12 15h.008v.008H12V15Zm-3-2.25h.008v.008H9v-.008ZM9 15h.008v.008H9V15Zm6-2.25h.008v.008H15v-.008ZM15 15h.008v.008H15V15Z" />
            <path d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" />
          </svg>
        )}
        {tab.href === "/settings" && (
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.324.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 0 1 1.37.49l1.296 2.247a1.125 1.125 0 0 1-.26 1.431l-1.003.827c-.293.241-.438.613-.43.992a7.723 7.723 0 0 1 0 .255c-.008.378.137.75.43.991l1.004.827c.424.35.534.955.26 1.43l-1.298 2.247a1.125 1.125 0 0 1-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.47 6.47 0 0 1-.22.128c-.331.183-.581.495-.644.869l-.213 1.28c-.09.543-.56.941-1.11.941h-2.594c-.55 0-1.02-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 0 1-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 0 1-1.369-.49l-1.297-2.247a1.125 1.125 0 0 1 .26-1.431l1.004-.827c.292-.24.437-.613.43-.991a6.932 6.932 0 0 1 0-.255c.007-.38-.138-.751-.43-.992l-1.004-.827a1.125 1.125 0 0 1-.26-1.43l1.297-2.247a1.125 1.125 0 0 1 1.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.086.22-.128.332-.183.582-.495.644-.869l.214-1.281Z" />
            <path d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
          </svg>
        )}
        <span class="text-[10px] font-medium leading-none">{tab.label}</span>
      </a>
    );
  })}
</nav>
