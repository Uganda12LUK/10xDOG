---
import { t } from "@/lib/i18n";

const { locale } = Astro.locals;
const pathname = Astro.url.pathname;

const links = [
  { code: "pl", label: t(locale, "lang.pl") },
  { code: "en", label: t(locale, "lang.en") },
] as const;
---

<div class="flex items-center gap-1 text-xs">
  {links.map((link) => (
    <a
      href={`${pathname}?lang=${link.code}`}
      class:list={[
        "px-1 transition-colors hover:underline",
        locale === link.code ? "font-semibold text-primary" : "text-muted-foreground hover:text-primary/80",
      ]}
      aria-current={locale === link.code ? "true" : undefined}
    >
      {link.label}
    </a>
  ))}
</div>
