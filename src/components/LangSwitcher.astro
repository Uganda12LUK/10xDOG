---
import { t } from "@/lib/i18n";

const { locale } = Astro.locals;

// Preserve any existing query params (e.g. ?receiver_id=…) when switching language —
// only the `lang` param is added. The middleware strips `lang` and redirects back to
// the same path with the rest intact, so deep-linked pages stay put after a switch.
const makeHref = (code: string): string => {
  const url = new URL(Astro.url);
  url.searchParams.set("lang", code);
  return url.pathname + url.search;
};

const links = [
  { code: "pl", label: t(locale, "lang.pl") },
  { code: "en", label: t(locale, "lang.en") },
] as const;
---

<div class="flex items-center gap-1 text-xs">
  {links.map((link) => (
    <a
      href={makeHref(link.code)}
      class:list={[
        "px-1 transition-colors hover:underline",
        locale === link.code ? "font-semibold text-primary" : "text-muted-foreground hover:text-primary/80",
      ]}
      aria-current={locale === link.code ? "true" : undefined}
    >
      {link.label}
    </a>
  ))}
</div>
