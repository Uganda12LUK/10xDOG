---
import { buttonVariants } from "@/components/ui/button";
import { badgeVariants } from "@/components/ui/badge";
import { ageStringFromBirthdate } from "@/lib/age";
import { t, type Locale } from "@/lib/i18n";
import type { Dog, Profile } from "@/types";

// Pure presentation: the real route (map/[id].astro) and the dev kitchen-sink
// render identical markup from these props. No data access, no Astro.locals.
interface Props {
  profile: Profile;
  dogs: Dog[];
  pendingInvitation: boolean;
  error: string | null;
  ownerId: string;
  locale: Locale;
}

const { profile, dogs, pendingInvitation, error, ownerId, locale } = Astro.props;

// Hero source: first dog with a photo → first dog → owner avatar → 🐾 placeholder.
const heroDog: Dog | null = dogs.length > 0 ? (dogs.find((dog) => dog.photoUrl) ?? dogs[0]) : null;
const heroSrc = heroDog?.photoUrl ?? profile.avatarUrl;
const location = profile.district ? `${profile.district}, ${profile.city}` : profile.city;
---

<div class="mx-auto flex min-h-[100svh] w-full max-w-2xl flex-col">
  <!-- Hero -->
  <div class="relative aspect-[4/3] w-full overflow-hidden bg-muted">
    {heroSrc ? (
      <img src={heroSrc} alt={profile.name} class="size-full object-cover" />
    ) : (
      <div class="flex size-full items-center justify-center text-6xl">🐾</div>
    )}
    <a
      href="/map"
      aria-label={t(locale, "ownerProfile.back")}
      class:list={[buttonVariants({ variant: "secondary", size: "icon" }), "absolute top-4 left-4 shadow-sm"]}
    >
      <span aria-hidden="true">←</span>
    </a>
  </div>

  <!-- Body -->
  <div class="flex-1 px-4 py-6">
    <h1 class="text-2xl font-bold text-foreground">{profile.name}</h1>
    {location ? <p class="mt-1 text-sm text-muted-foreground">{location}</p> : null}

    {error ? (
      <div class="mt-4 rounded-lg border border-destructive/30 bg-destructive/10 px-3 py-2 text-sm text-destructive">
        {error}
      </div>
    ) : null}

    {dogs.length > 0 ? (
      <div class="mt-6">
        <h2 class="mb-3 text-sm font-medium text-muted-foreground">{t(locale, "ownerProfile.dogsHeading")}</h2>
        <ul class="space-y-4">
          {dogs.map((dog) => {
            const age = ageStringFromBirthdate(dog.birthdate);
            return (
              <li class="rounded-xl border border-border bg-card p-4 text-card-foreground">
                <div class="flex items-center gap-3">
                  {dog.photoUrl ? (
                    <img
                      src={dog.photoUrl}
                      alt={dog.name}
                      class="size-12 rounded-full border border-border object-cover"
                    />
                  ) : (
                    <div class="flex size-12 items-center justify-center rounded-full border border-border bg-muted text-lg">
                      🐾
                    </div>
                  )}
                  <div class="min-w-0">
                    <p class="truncate font-medium text-foreground">{dog.name}</p>
                    {age ? <p class="text-xs text-muted-foreground">{age}</p> : null}
                  </div>
                </div>
                <div class="mt-3 flex flex-wrap gap-1.5">
                  <span class:list={badgeVariants({ variant: "default" })}>{dog.breed}</span>
                  {dog.size ? (
                    <span class:list={badgeVariants({ variant: "secondary" })}>{t(locale, `size.${dog.size}`)}</span>
                  ) : null}
                  {dog.traits.map((trait) => (
                    <span class:list={badgeVariants({ variant: "outline" })}>{t(locale, `trait.${trait}`)}</span>
                  ))}
                </div>
              </li>
            );
          })}
        </ul>
      </div>
    ) : (
      <div class="mt-6 rounded-xl border border-dashed border-border bg-card p-8 text-center text-card-foreground">
        <div class="text-4xl">🐾</div>
        <p class="mt-2 text-sm text-muted-foreground">{t(locale, "ownerProfile.empty")}</p>
      </div>
    )}
  </div>

  <!-- Sticky action footer -->
  <div class="sticky bottom-0 border-t border-border bg-background/95 px-4 py-3 backdrop-blur">
    <div class="flex gap-3">
      {pendingInvitation ? (
        <button type="button" disabled class:list={[buttonVariants(), "flex-1"]}>
          {t(locale, "ownerProfile.pending")}
        </button>
      ) : (
        <a href={`/meetings/new?receiver_id=${ownerId}`} class:list={[buttonVariants(), "flex-1"]}>
          {t(locale, "ownerProfile.propose")}
        </a>
      )}
      <a href="/map" class:list={buttonVariants({ variant: "outline" })}>
        {t(locale, "ownerProfile.back")}
      </a>
    </div>
  </div>
</div>
