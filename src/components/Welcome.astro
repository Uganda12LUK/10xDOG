---
import { t } from "@/lib/i18n";

const { locale } = Astro.locals;
---

<div class="px-4 pb-8 sm:px-8">
  <!-- Hero section -->
  <div class="mx-auto flex max-w-4xl flex-col items-center justify-center px-4 py-24 text-center sm:py-32 lg:py-40">
    <h1 class="mb-6 text-5xl font-bold leading-tight text-foreground sm:text-6xl lg:text-7xl">PawMeet</h1>
    <p class="mb-10 max-w-2xl text-lg text-muted-foreground sm:text-xl">{t(locale, "landing.tagline")}</p>
    <div class="flex flex-col gap-4 sm:flex-row">
      <a
        href="/auth/signup"
        class="inline-flex items-center justify-center rounded-lg bg-primary px-6 py-3 text-base font-medium text-primary-foreground transition-colors hover:bg-primary/90"
      >
        {t(locale, "landing.getStarted")}
      </a>
      <a
        href="/auth/signin"
        class="inline-flex items-center justify-center rounded-lg border border-border px-6 py-3 text-base font-medium text-foreground transition-colors hover:bg-accent"
      >
        {t(locale, "auth.signIn")}
      </a>
    </div>
  </div>

  <!-- Feature cards -->
  <div class="mx-auto grid max-w-4xl grid-cols-1 gap-6 px-4 pb-24 sm:grid-cols-3">
    <div class="rounded-xl border border-border bg-card p-6">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="mb-4 text-primary"
      >
        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
        <circle cx="9" cy="7" r="4"></circle>
        <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
        <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
      </svg>
      <h3 class="mb-2 text-lg font-semibold text-foreground">{t(locale, "landing.feature1.title")}</h3>
      <p class="text-sm leading-relaxed text-muted-foreground">{t(locale, "landing.feature1.desc")}</p>
    </div>

    <div class="rounded-xl border border-border bg-card p-6">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="mb-4 text-primary"
      >
        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
        <polyline points="9 22 9 12 15 12 15 22"></polyline>
      </svg>
      <h3 class="mb-2 text-lg font-semibold text-foreground">{t(locale, "landing.feature2.title")}</h3>
      <p class="text-sm leading-relaxed text-muted-foreground">{t(locale, "landing.feature2.desc")}</p>
    </div>

    <div class="rounded-xl border border-border bg-card p-6">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="mb-4 text-primary"
      >
        <circle cx="12" cy="12" r="10"></circle>
        <path d="M8.56 2.75c4.37 6.03 6.02 9.42 8.03 17.72m2.54-15.38c-3.72 4.35-8.94 5.66-16.88 5.85m19.5 1.9c-3.5-.93-6.63-.82-8.94 0-2.58.92-5.01 2.86-7.44 6.32"></path>
      </svg>
      <h3 class="mb-2 text-lg font-semibold text-foreground">{t(locale, "landing.feature3.title")}</h3>
      <p class="text-sm leading-relaxed text-muted-foreground">{t(locale, "landing.feature3.desc")}</p>
    </div>
  </div>
</div>
