---
import { createClient } from "@/lib/supabase";
import { countReceivedPending } from "@/lib/services/invitation";

const { user } = Astro.locals;

let pendingCount = 0;
if (user) {
  const supabase = createClient(Astro.request.headers, Astro.cookies);
  if (supabase) {
    pendingCount = await countReceivedPending(supabase, user.id);
  }
}
---

<div class="mb-4 flex items-center justify-between rounded-xl border border-white/10 bg-white/5 px-4 py-2 text-sm text-white/80">
  {user ? (
    <>
      <span class="text-blue-100/70">{user.email}</span>
      <div class="flex items-center gap-3">
        <a href="/dashboard" class="text-purple-300 transition-colors hover:text-purple-100 hover:underline">
          Dashboard
        </a>
        <a href="/owners" class="text-purple-300 transition-colors hover:text-purple-100 hover:underline">
          Owners
        </a>
        <a href="/invitations" class="text-purple-300 transition-colors hover:text-purple-100 hover:underline">
          Invitations{pendingCount > 0 ? ` (${pendingCount})` : ""}
        </a>
        <a href="/profile" class="text-purple-300 transition-colors hover:text-purple-100 hover:underline">
          Profile
        </a>
        <a href="/dogs" class="text-purple-300 transition-colors hover:text-purple-100 hover:underline">
          Dogs
        </a>
        <form method="POST" action="/api/auth/signout">
          <button type="submit" class="text-purple-300 transition-colors hover:text-purple-100 hover:underline">
            Sign out
          </button>
        </form>
      </div>
    </>
  ) : (
    <>
      <span class="text-blue-100/70">Not signed in</span>
      <div class="flex gap-3">
        <a href="/auth/signin" class="text-purple-300 transition-colors hover:text-purple-100 hover:underline">
          Sign in
        </a>
        <a href="/auth/signup" class="text-purple-300 transition-colors hover:text-purple-100 hover:underline">
          Sign up
        </a>
      </div>
    </>
  )}
</div>
