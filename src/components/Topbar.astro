---
import { createClient } from "@/lib/supabase";
import { countReceivedPending } from "@/lib/services/invitation";
import LangSwitcher from "@/components/LangSwitcher.astro";

const { user } = Astro.locals;

let pendingCount = 0;
if (user) {
  const supabase = createClient(Astro.request.headers, Astro.cookies);
  if (supabase) {
    pendingCount = await countReceivedPending(supabase, user.id);
  }
}
---

<div class="mx-auto mb-4 hidden max-w-4xl items-center justify-between rounded-xl border border-border bg-card px-4 py-2 text-sm text-card-foreground md:flex">
  {user ? (
    <>
      <span class="text-muted-foreground">{user.email}</span>
      <div class="flex items-center gap-3">
        <a href="/dashboard" class="text-primary transition-colors hover:text-primary/80 hover:underline">
          Dashboard
        </a>
        <a href="/owners" class="text-primary transition-colors hover:text-primary/80 hover:underline">
          Owners
        </a>
        <a href="/meetings" class="text-primary transition-colors hover:text-primary/80 hover:underline">
          Meetings{pendingCount > 0 ? ` (${pendingCount})` : ""}
        </a>
        <a href="/profile" class="text-primary transition-colors hover:text-primary/80 hover:underline">
          Profile
        </a>
        <a href="/dogs" class="text-primary transition-colors hover:text-primary/80 hover:underline">
          Dogs
        </a>
        <form method="POST" action="/api/auth/signout">
          <button type="submit" class="text-primary transition-colors hover:text-primary/80 hover:underline">
            Sign out
          </button>
        </form>
        <LangSwitcher />
      </div>
    </>
  ) : (
    <>
      <span class="text-muted-foreground">Not signed in</span>
      <div class="flex gap-3">
        <a href="/auth/signin" class="text-primary transition-colors hover:text-primary/80 hover:underline">
          Sign in
        </a>
        <a href="/auth/signup" class="text-primary transition-colors hover:text-primary/80 hover:underline">
          Sign up
        </a>
        <LangSwitcher />
      </div>
    </>
  )}
</div>
