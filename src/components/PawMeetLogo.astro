---
/**
 * PawMeet brand mark — a coral paw print.
 * Color comes from the parent (`text-primary` by default via currentColor),
 * never a color literal, so it tracks the design-system tokens in light/dark.
 */
interface Props {
  /** Extra classes for sizing/color on the <svg> (e.g. "size-10 text-primary"). */
  class?: string;
}

const { class: className = "size-8 text-primary" } = Astro.props;
---

<svg viewBox="0 0 24 24" fill="currentColor" role="img" aria-label="PawMeet" class:list={[className]}>
  <ellipse cx="6.2" cy="10.2" rx="2.1" ry="2.6"></ellipse>
  <ellipse cx="10.2" cy="6.6" rx="2.1" ry="2.7"></ellipse>
  <ellipse cx="14.3" cy="6.6" rx="2.1" ry="2.7"></ellipse>
  <ellipse cx="18.2" cy="10.2" rx="2.1" ry="2.6"></ellipse>
  <path d="M12 11.3c-3 0-5.6 1.9-6.6 4.6-.3.8-.5 1.6-.5 2.3 0 2 1.6 3.3 3.6 3.3 1.3 0 2.5-.6 3.5-1 .9.4 2.2 1 3.5 1 2 0 3.6-1.3 3.6-3.3 0-.7-.2-1.5-.5-2.3-1-2.7-3.6-4.6-6.6-4.6z"></path>
</svg>
