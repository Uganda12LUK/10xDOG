---
import Layout from "@/layouts/Layout.astro";
import DogCalendar from "@/components/calendar/DogCalendar";
import { createClient } from "@/lib/supabase";
import { listDogs } from "@/lib/services/dog";
import { listEventsForOwner } from "@/lib/services/dogEvents";
import { buttonVariants } from "@/components/ui/button";
import { t } from "@/lib/i18n";
import type { Dog, DogEvent } from "@/types";

const { user, locale } = Astro.locals;
const supabase = createClient(Astro.request.headers, Astro.cookies);

let dogs: Dog[] = [];
let events: DogEvent[] = [];
if (supabase && user) {
  [dogs, events] = await Promise.all([listDogs(supabase, user.id), listEventsForOwner(supabase, user.id)]);
}
const dogOptions = dogs.map((d) => ({ id: d.id, name: d.name }));
---

<Layout title={t(locale, "dogEvent.pageTitle")}>
  <div class="mx-auto w-full max-w-2xl px-4 py-6">
    <h1 class="mb-6 flex items-center gap-2 text-2xl font-bold text-foreground">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="26"
        height="26"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="text-primary"
        aria-hidden="true"
      >
        <path d="M12 12.75h.008v.008H12v-.008ZM12 15h.008v.008H12V15Zm-3-2.25h.008v.008H9v-.008ZM9 15h.008v.008H9V15Zm6-2.25h.008v.008H15v-.008ZM15 15h.008v.008H15V15Z" />
        <path d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" />
      </svg>
      {t(locale, "dogEvent.pageTitle")}
    </h1>

    {dogs.length === 0 ? (
      <div class="rounded-xl border border-border bg-card p-8 text-center text-card-foreground">
        <p class="mb-4 text-muted-foreground">{t(locale, "dogEvent.needDog")}</p>
        <a href="/dogs/new" class:list={[buttonVariants({ size: "sm" })]}>
          {t(locale, "dogs.add")}
        </a>
      </div>
    ) : (
      <DogCalendar dogs={dogOptions} initialEvents={events} locale={locale} client:load />
    )}
  </div>
</Layout>
