---
import Layout from "@/layouts/Layout.astro";
import { createClient } from "@/lib/supabase";
import { listReceivedPending, listSentPending } from "@/lib/services/invitation";
import { getProfile } from "@/lib/services/profile";
import type { Invitation, Profile } from "@/types";

const { user } = Astro.locals;

const supabase = createClient(Astro.request.headers, Astro.cookies);

let receivedInvitations: Invitation[] = [];
let sentInvitations: Invitation[] = [];
const profileMap = new Map<string, Profile | null>();

if (supabase && user) {
  [receivedInvitations, sentInvitations] = await Promise.all([
    listReceivedPending(supabase, user.id),
    listSentPending(supabase, user.id),
  ]);

  // Collect all unique counterparty IDs
  const counterpartyIds = new Set<string>();
  for (const inv of receivedInvitations) {
    counterpartyIds.add(inv.senderId);
  }
  for (const inv of sentInvitations) {
    counterpartyIds.add(inv.receiverId);
  }

  // Fetch profiles for all counterparties
  await Promise.all(
    Array.from(counterpartyIds).map(async (id) => {
      const profile = await getProfile(supabase, id);
      profileMap.set(id, profile);
    }),
  );
}

const saved = Astro.url.searchParams.get("saved");
const error = Astro.url.searchParams.get("error");

const hasAny = receivedInvitations.length > 0 || sentInvitations.length > 0;
---

<Layout title="Invitations">
  <div class="flex justify-center p-4">
    <div class="w-full max-w-lg text-white">
      <div class="mb-6 flex items-center justify-between">
        <h1 class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-2xl font-bold text-transparent">
          Invitations
        </h1>
      </div>

      {saved === "1" ? (
        <div class="mb-4 rounded-lg border border-green-500/30 bg-green-900/30 px-3 py-2 text-sm text-green-200">
          Invitation response saved.
        </div>
      ) : null}
      {error ? (
        <div class="mb-4 rounded-lg border border-red-500/30 bg-red-900/30 px-3 py-2 text-sm text-red-200">{error}</div>
      ) : null}

      {!hasAny ? (
        <div class="rounded-2xl border border-white/10 bg-white/10 p-8 text-center text-blue-100/80 backdrop-blur-xl">
          No pending invitations.{" "}
          <a href="/owners" class="text-purple-300 hover:underline">
            Browse owners →
          </a>
        </div>
      ) : (
        <>
          <section class="mb-8">
            <h2 class="mb-3 text-sm font-medium uppercase tracking-wide text-blue-100/60">Incoming</h2>
            {receivedInvitations.length === 0 ? (
              <p class="text-sm text-blue-100/60">No pending invitations.</p>
            ) : (
              <ul class="space-y-3">
                {receivedInvitations.map((inv) => {
                  const sender = profileMap.get(inv.senderId);
                  const senderName = sender?.name ?? "Unknown";
                  return (
                    <li class="rounded-2xl border border-white/10 bg-white/10 p-4 backdrop-blur-xl">
                      <p class="mb-3 text-sm text-blue-100/80">
                        <span class="font-medium text-white">{senderName}</span> sent you a walk invitation
                      </p>
                      <div class="flex gap-2">
                        <form method="POST" action={`/api/invitations/${inv.id}`}>
                          <input type="hidden" name="_action" value="accept" />
                          <button
                            type="submit"
                            class="rounded-lg bg-green-600/80 px-3 py-1 text-sm text-white hover:bg-green-500"
                          >
                            Accept
                          </button>
                        </form>
                        <form method="POST" action={`/api/invitations/${inv.id}`}>
                          <input type="hidden" name="_action" value="decline" />
                          <button
                            type="submit"
                            class="rounded-lg bg-red-600/60 px-3 py-1 text-sm text-white hover:bg-red-500"
                          >
                            Decline
                          </button>
                        </form>
                      </div>
                    </li>
                  );
                })}
              </ul>
            )}
          </section>

          {sentInvitations.length > 0 ? (
            <section>
              <h2 class="mb-3 text-sm font-medium uppercase tracking-wide text-blue-100/60">Outgoing</h2>
              <ul class="space-y-3">
                {sentInvitations.map((inv) => {
                  const receiver = profileMap.get(inv.receiverId);
                  const receiverName = receiver?.name ?? "Unknown";
                  return (
                    <li class="rounded-2xl border border-white/10 bg-white/10 p-4 backdrop-blur-xl">
                      <p class="text-sm text-blue-100/80">
                        You invited <span class="font-medium text-white">{receiverName}</span> for a walk ·{" "}
                        <span class="text-blue-100/60">Awaiting response</span>
                      </p>
                    </li>
                  );
                })}
              </ul>
            </section>
          ) : null}
        </>
      )}
    </div>
  </div>
</Layout>
