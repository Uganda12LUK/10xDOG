---
import Layout from "@/layouts/Layout.astro";
import SignUpForm from "@/components/auth/SignUpForm";
import { t } from "@/lib/i18n";

const { locale } = Astro.locals;
const error = Astro.url.searchParams.get("error");
---

<Layout title={t(locale, "auth.signUp")}>
  <div class="flex min-h-[80vh] items-center justify-center p-4">
    <div class="w-full max-w-sm rounded-2xl border border-border bg-card p-8 text-card-foreground">
      <h1 class="mb-6 text-center text-2xl font-bold text-foreground">{t(locale, "auth.signUp")}</h1>
      <SignUpForm serverError={error} locale={locale} client:load />
      <p class="mt-4 text-center text-sm text-muted-foreground">
        {t(locale, "auth.haveAccount")}{" "}
        <a href="/auth/signin" class="text-primary hover:underline">
          {t(locale, "auth.signIn")}
        </a>
      </p>
    </div>
  </div>
</Layout>
