---
import Layout from "@/layouts/Layout.astro";
import { createClient } from "@/lib/supabase";
import { listDogsForMap, getProfile, getOwnLocation } from "@/lib/services/profile";
import { listPackStatuses } from "@/lib/services/pack";
import OwnersMapView from "@/components/map/OwnersMapView";
import { t } from "@/lib/i18n";
import type { DogWithOwner, PackStatus } from "@/types";

const { user, locale } = Astro.locals;

const supabase = createClient(Astro.request.headers, Astro.cookies);

let dogs: DogWithOwner[] = [];
let myCity: string | null = null;
let hasCity = false;
let myLocation: [number, number] | null = null;
let packStatusByOwner: Record<string, PackStatus> = {};

if (supabase && user) {
  const profile = await getProfile(supabase, user.id);
  myCity = profile?.city ?? null;
  hasCity = myCity != null && myCity.length > 0;
  // Own pin comes from the owner-only location table, not the public profile.
  const ownLocation = await getOwnLocation(supabase, user.id);
  if (ownLocation?.locationLat != null && ownLocation.locationLng != null) {
    myLocation = [ownLocation.locationLat, ownLocation.locationLng];
  }

  if (hasCity && myCity) {
    // Discovery is scoped server-side by the discoverable_owner_ids RPC (no coords leave the DB).
    [dogs, packStatusByOwner] = await Promise.all([listDogsForMap(supabase), listPackStatuses(supabase, user.id)]);
  }
}
---

<Layout title={t(locale, "owners.title")}>
  {!hasCity ? (
    <div class="flex justify-center p-4">
      <div class="w-full max-w-lg">
        <div class="rounded-2xl border border-border bg-card p-8 text-center text-muted-foreground">
          {t(locale, "owners.setCityPrompt")}{" "}
          <a href="/profile" class="text-primary hover:underline">
            {t(locale, "owners.profileLink")}
          </a>{" "}
          {t(locale, "owners.setCityPromptSuffix")}
        </div>
      </div>
    </div>
  ) : (
    <OwnersMapView
      dogs={dogs}
      city={myCity ?? ""}
      userLocation={myLocation}
      packStatusByOwner={packStatusByOwner}
      locale={locale}
      client:only="react"
    />
  )}
</Layout>
