---
import Layout from "@/layouts/Layout.astro";
import { createClient } from "@/lib/supabase";
import { listDogs } from "@/lib/services/dog";
import { getProfile } from "@/lib/services/profile";
import { ageStringFromBirthdate } from "@/lib/age";
import type { Dog } from "@/types";

const { user } = Astro.locals;

const supabase = createClient(Astro.request.headers, Astro.cookies);
let dogs: Dog[] = [];
let displayName = user?.email?.split("@")[0] ?? "você";
if (supabase && user) {
  const [fetchedDogs, profile] = await Promise.all([listDogs(supabase, user.id), getProfile(supabase, user.id)]);
  dogs = fetchedDogs;
  if (profile?.name) displayName = profile.name;
}
const firstDog: Dog | null = dogs.length > 0 ? dogs[0] : null;

const tiles = [
  { label: "Zaproponuj spotkanie", href: "/meetings/new", soon: true, icon: "calendar-plus" },
  { label: "Znajdź psy", href: "/owners", soon: false, icon: "map-pin" },
  { label: "Mapa spacerów", href: "/owners", soon: false, icon: "map" },
  { label: "Moje spotkania", href: "/meetings", soon: false, icon: "calendar" },
  { label: "Wydarzenia", href: "/events", soon: false, icon: "star" },
  { label: "Miejsca", href: "/places", soon: true, icon: "building" },
];
---

<Layout title="Start">
  <div class="mx-auto max-w-lg px-4 py-4">
    <!-- Header -->
    <header class="mb-5 flex items-center justify-between">
      <div>
        <p class="text-sm text-muted-foreground">Witaj z powrotem</p>
        <h1 class="text-2xl font-bold text-foreground">Cześć, {displayName}!</h1>
      </div>
      <a
        href="/profile"
        class="flex size-10 items-center justify-center rounded-full bg-muted text-sm font-semibold text-muted-foreground transition-colors hover:bg-accent"
        aria-label="Przejdź do profilu"
      >
        {displayName.charAt(0).toUpperCase()}
      </a>
    </header>

    <!-- DogCard or CTA -->
    {firstDog ? (
      <a
        href={`/dogs/${firstDog.id}`}
        class="card-interactive mb-4 block overflow-hidden rounded-xl bg-card shadow-card"
      >
        <div class="aspect-[4/3] bg-muted">
          {firstDog.photoUrl ? (
            <img src={firstDog.photoUrl} alt={firstDog.name} class="size-full object-cover" />
          ) : (
            <div class="flex size-full items-center justify-center text-5xl">🐾</div>
          )}
        </div>
        <div class="flex items-center justify-between p-3">
          <div>
            <p class="font-semibold text-foreground">{firstDog.name}</p>
            <span class="text-sm text-muted-foreground">
              {firstDog.breed}
              {ageStringFromBirthdate(firstDog.birthdate) ? ` · ${ageStringFromBirthdate(firstDog.birthdate)}` : ""}
            </span>
          </div>
          <!-- chevron-right -->
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="text-muted-foreground"
          >
            <path d="M9 18l6-6-6-6" />
          </svg>
        </div>
      </a>
    ) : (
      <a
        href="/dogs/new"
        class="card-interactive mb-4 flex items-center justify-center gap-3 rounded-xl border-2 border-dashed border-border bg-card p-6 text-center shadow-card"
      >
        <!-- plus icon -->
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="shrink-0 text-muted-foreground"
        >
          <path d="M12 5v14M5 12h14" />
        </svg>
        <span class="font-medium text-foreground">Dodaj pierwszego psa</span>
      </a>
    )}

    <!-- Quick-action grid 3×2 -->
    <div class="grid grid-cols-3 gap-3">
      {tiles.map((tile) =>
        tile.soon ? (
          <div class="flex flex-col items-center justify-center gap-1.5 rounded-xl bg-card p-3 shadow-card text-center opacity-60 cursor-default">
            {tile.icon === "calendar-plus" && (
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" />
              </svg>
            )}
            {tile.icon === "building" && (
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M3.75 21h16.5M4.5 3h15M5.25 3v18m13.5-18v18M9 6.75h1.5m-1.5 3h1.5m-1.5 3h1.5m3-6H15m-1.5 3H15m-1.5 3H15M9 21v-3.375c0-.621.504-1.125 1.125-1.125h3.75c.621 0 1.125.504 1.125 1.125V21" />
              </svg>
            )}
            <span class="text-[11px] font-medium leading-tight text-foreground">{tile.label}</span>
            <span class="mt-0.5 rounded-full bg-muted px-2 py-0.5 text-[10px] text-muted-foreground">Wkrótce</span>
          </div>
        ) : (
          <a
            href={tile.href}
            class="card-interactive flex flex-col items-center justify-center gap-1.5 rounded-xl bg-card p-3 shadow-card text-center"
          >
            {tile.icon === "map-pin" && (
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                <path d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
              </svg>
            )}
            {tile.icon === "map" && (
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M9 6.75V15m6-6v8.25m.503 3.498 4.875-2.437c.381-.19.622-.58.622-1.006V4.82c0-.836-.88-1.38-1.628-1.006l-3.869 1.934c-.317.159-.69.159-1.006 0L9.503 3.252a1.125 1.125 0 0 0-1.006 0L3.622 5.689C3.24 5.88 3 6.27 3 6.695V19.18c0 .836.88 1.38 1.628 1.006l3.869-1.934c.317-.159.69-.159 1.006 0l4.994 2.497c.317.158.69.158 1.006 0Z" />
              </svg>
            )}
            {tile.icon === "calendar" && (
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" />
              </svg>
            )}
            {tile.icon === "star" && (
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M11.48 3.499a.562.562 0 0 1 1.04 0l2.125 5.111a.563.563 0 0 0 .475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 0 0-.182.557l1.285 5.385a.562.562 0 0 1-.84.61l-4.725-2.885a.562.562 0 0 0-.586 0L6.982 20.54a.562.562 0 0 1-.84-.61l1.285-5.386a.562.562 0 0 0-.182-.557l-4.204-3.602a.562.562 0 0 1 .321-.988l5.518-.442a.563.563 0 0 0 .475-.345L11.48 3.5Z" />
              </svg>
            )}
            <span class="text-[11px] font-medium leading-tight text-foreground">{tile.label}</span>
          </a>
        ),
      )}
    </div>
  </div>
</Layout>
