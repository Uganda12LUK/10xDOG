---
import Layout from "@/layouts/Layout.astro";
import { createClient } from "@/lib/supabase";
import { listDogs } from "@/lib/services/dog";
import { getProfile } from "@/lib/services/profile";
import { ageStringFromBirthdate } from "@/lib/age";
import { t } from "@/lib/i18n";
import type { Dog } from "@/types";

const { user, locale } = Astro.locals;

const supabase = createClient(Astro.request.headers, Astro.cookies);
let dogs: Dog[] = [];
let displayName = user?.email?.split("@")[0] ?? "você";
if (supabase && user) {
  const [fetchedDogs, profile] = await Promise.all([listDogs(supabase, user.id), getProfile(supabase, user.id)]);
  dogs = fetchedDogs;
  if (profile?.name) displayName = profile.name;
}
const firstDog: Dog | null = dogs.length > 0 ? dogs[0] : null;

// Only real, working destinations — kept in sync with the Topbar + BottomNav so the
// navigation and the tiles always reference the same set of features.
const tiles = [
  { label: t(locale, "dashboard.tiles.dogMap"), href: "/map", icon: "map-pin" },
  { label: t(locale, "dashboard.tiles.myMeetings"), href: "/meetings", icon: "calendar" },
  { label: t(locale, "dashboard.tiles.dogs"), href: "/dogs", icon: "dog" },
  { label: t(locale, "dashboard.tiles.profile"), href: "/profile", icon: "user" },
];
---

<Layout title="Start">
  <div class="mx-auto max-w-lg px-4 py-4 md:max-w-4xl">
    <!-- Header -->
    <header class="mb-5">
      <p class="text-sm text-muted-foreground">{t(locale, "dashboard.welcomeBack")}</p>
      <h1 class="text-2xl font-bold text-foreground">
        {t(locale, "dashboard.greeting")}, {displayName}!
      </h1>
    </header>

    <!-- DogCard or CTA -->
    {firstDog ? (
      <a
        href={`/dogs/${firstDog.id}`}
        class="card-interactive mb-4 block overflow-hidden rounded-xl bg-card shadow-card md:max-w-md"
      >
        <div class="aspect-[4/3] bg-muted">
          {firstDog.photoUrl ? (
            <img src={firstDog.photoUrl} alt={firstDog.name} class="size-full object-cover" />
          ) : (
            <div class="flex size-full items-center justify-center text-5xl">🐾</div>
          )}
        </div>
        <div class="flex items-center justify-between p-3">
          <div>
            <p class="font-semibold text-foreground">{firstDog.name}</p>
            <span class="text-sm text-muted-foreground">
              {firstDog.breed}
              {ageStringFromBirthdate(firstDog.birthdate) ? ` · ${ageStringFromBirthdate(firstDog.birthdate)}` : ""}
            </span>
          </div>
          <!-- chevron-right -->
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="text-muted-foreground"
          >
            <path d="M9 18l6-6-6-6" />
          </svg>
        </div>
      </a>
    ) : (
      <a
        href="/dogs/new"
        class="card-interactive mb-4 flex items-center justify-center gap-3 rounded-xl border-2 border-dashed border-border bg-card p-6 text-center shadow-card md:max-w-md"
      >
        <!-- plus icon -->
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="shrink-0 text-muted-foreground"
        >
          <path d="M12 5v14M5 12h14" />
        </svg>
        <span class="font-medium text-foreground">{t(locale, "dashboard.addFirstDog")}</span>
      </a>
    )}

    <!-- Quick-action grid — real destinations only -->
    <div class="grid grid-cols-2 gap-3 md:grid-cols-4">
      {tiles.map((tile) => (
        <a
          href={tile.href}
          class="card-interactive flex flex-col items-center justify-center gap-1.5 rounded-xl bg-card p-3 shadow-card text-center"
        >
          {tile.icon === "map-pin" && (
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
              <path d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
            </svg>
          )}
          {tile.icon === "calendar" && (
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" />
            </svg>
          )}
          {tile.icon === "dog" && (
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M10 5.172C10 3.782 8.423 2.679 6.5 3c-2.823.47-4.113 6.006-4 7 .08.703 1.725 1.722 3.656 1 1.261-.472 1.96-1.45 2.344-2.5" />
              <path d="M14.267 5.172c0-1.39 1.577-2.493 3.5-2.172 2.823.47 4.113 6.006 4 7-.08.703-1.725 1.722-3.656 1-1.261-.472-1.855-1.45-2.239-2.5" />
              <path d="M8 14v.5M16 14v.5" />
              <path d="M11.25 16.25h1.5L12 17l-.75-.75Z" />
              <path d="M4.42 11.247A13.152 13.152 0 0 0 4 14.556C4 18.728 7.582 21 12 21s8-2.272 8-6.444c0-1.061-.162-2.2-.493-3.309m-9.243-6.082A8.801 8.801 0 0 1 12 4c.78 0 1.5.108 2.161.306" />
            </svg>
          )}
          {tile.icon === "user" && (
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" />
            </svg>
          )}
          <span class="text-[11px] font-medium leading-tight text-foreground">{tile.label}</span>
        </a>
      ))}
    </div>
  </div>
</Layout>
