---
import Layout from "@/layouts/Layout.astro";
---

<Layout title="Wydarzenia">
  <div class="flex min-h-[60vh] flex-col items-center justify-center gap-3 p-6 text-center">
    <span class="text-5xl">🐾</span>
    <h1 class="text-2xl font-semibold text-foreground">Wydarzenia</h1>
    <p class="text-muted-foreground">Ta sekcja jest w przygotowaniu.</p>
    <span class="rounded-full bg-primary/10 px-3 py-1 text-xs font-medium text-primary">Wkrótce</span>
  </div>
</Layout>
