---
import Layout from "@/layouts/Layout.astro";
import { t } from "@/lib/i18n";

const { locale } = Astro.locals;
---

<Layout title={t(locale, "events.title")}>
  <div class="flex min-h-[60vh] flex-col items-center justify-center gap-3 p-6 text-center">
    <span class="text-5xl">🐾</span>
    <h1 class="text-2xl font-semibold text-foreground">{t(locale, "events.title")}</h1>
    <p class="text-muted-foreground">{t(locale, "events.inPreparation")}</p>
    <span class="rounded-full bg-primary/10 px-3 py-1 text-xs font-medium text-primary">
      {t(locale, "events.soon")}
    </span>
  </div>
</Layout>
