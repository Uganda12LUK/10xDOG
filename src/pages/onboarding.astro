---
import Layout from "@/layouts/Layout.astro";
import OnboardingWizard from "@/components/onboarding/OnboardingWizard";
import { createClient } from "@/lib/supabase";
import { getProfile } from "@/lib/services/profile";
import { t } from "@/lib/i18n";

const { user, locale } = Astro.locals;

// Prefill the name from an existing profile, else the email local-part — a gentle
// default the user can overwrite. The wizard itself saves via /api/profile + /api/dogs.
let defaultName = user?.email?.split("@")[0] ?? "";
const supabase = createClient(Astro.request.headers, Astro.cookies);
if (supabase && user) {
  const profile = await getProfile(supabase, user.id);
  if (profile?.name) defaultName = profile.name;
}
---

<Layout title={t(locale, "onboarding.title")}>
  <div class="mx-auto w-full max-w-2xl px-4 py-6">
    <OnboardingWizard defaultName={defaultName} locale={locale} client:only="react">
      <p slot="fallback" class="text-muted-foreground text-sm">
        {t(locale, "common.loading")}
      </p>
    </OnboardingWizard>
  </div>
</Layout>
