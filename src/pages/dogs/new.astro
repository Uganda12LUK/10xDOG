---
import Layout from "@/layouts/Layout.astro";
import DogForm from "@/components/dogs/DogForm";
import { t } from "@/lib/i18n";

const { locale } = Astro.locals;
const error = Astro.url.searchParams.get("error");
---

<Layout title={t(locale, "dogs.addTitle")}>
  <div class="flex min-h-[80vh] items-center justify-center p-4">
    <div class="w-full max-w-sm rounded-2xl border border-border bg-card p-8 text-card-foreground">
      <h1 class="mb-6 text-center text-2xl font-bold text-foreground">{t(locale, "dogs.addTitle")}</h1>
      <DogForm serverError={error} locale={locale} client:load />
    </div>
  </div>
</Layout>
