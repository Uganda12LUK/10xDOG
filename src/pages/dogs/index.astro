---
import Layout from "@/layouts/Layout.astro";
import { createClient } from "@/lib/supabase";
import { listDogs } from "@/lib/services/dog";
import { ageFromBirthdate } from "@/lib/age";
import type { Dog } from "@/types";

const { user } = Astro.locals;

const supabase = createClient(Astro.request.headers, Astro.cookies);
let dogs: Dog[] = [];
if (supabase && user) {
  dogs = await listDogs(supabase, user.id);
}

const error = Astro.url.searchParams.get("error");
const saved = Astro.url.searchParams.get("saved");
---

<Layout title="Your dogs">
  <div class="flex justify-center p-4">
    <div class="w-full max-w-lg text-white">
      <div class="mb-6 flex items-center justify-between">
        <h1 class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-2xl font-bold text-transparent">
          Your dogs
        </h1>
        <a
          href="/dogs/new"
          class="rounded-lg bg-purple-600 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-purple-500"
        >
          Add dog
        </a>
      </div>

      {error ? (
        <p class="mb-4 rounded-lg border border-red-500/30 bg-red-900/30 px-3 py-2 text-sm text-red-300">{error}</p>
      ) : null}

      {saved === "1" ? (
        <p class="mb-4 rounded-lg border border-green-500/30 bg-green-900/30 px-3 py-2 text-sm text-green-300">
          Saved.
        </p>
      ) : null}

      {dogs.length === 0 ? (
        <div class="rounded-2xl border border-white/10 bg-white/10 p-8 text-center text-blue-100/80 backdrop-blur-xl">
          No dogs yet — add your first!
        </div>
      ) : (
        <ul class="space-y-3">
          {dogs.map((dog) => {
            const age = ageFromBirthdate(dog.birthdate);
            return (
              <li>
                <a
                  href={`/dogs/${dog.id}`}
                  class="flex items-center gap-4 rounded-2xl border border-white/10 bg-white/10 p-4 backdrop-blur-xl transition-colors hover:bg-white/15"
                >
                  {dog.photoUrl ? (
                    <img
                      src={dog.photoUrl}
                      alt={dog.name}
                      class="size-16 rounded-full border border-white/20 object-cover"
                    />
                  ) : (
                    <div class="flex size-16 items-center justify-center rounded-full border border-white/20 bg-white/10 text-xl">
                      🐾
                    </div>
                  )}
                  <div class="min-w-0">
                    <p class="truncate font-medium text-white">{dog.name}</p>
                    <p class="truncate text-sm text-blue-100/70">{dog.breed}</p>
                    {age !== null ? <p class="text-xs text-blue-100/60">{age} yrs</p> : null}
                  </div>
                </a>
              </li>
            );
          })}
        </ul>
      )}
    </div>
  </div>
</Layout>
