---
import Layout from "@/layouts/Layout.astro";
import { createClient } from "@/lib/supabase";
import { listDogs } from "@/lib/services/dog";
import { ageFromBirthdate } from "@/lib/age";
import { t } from "@/lib/i18n";
import type { Dog } from "@/types";

const { user, locale } = Astro.locals;

const supabase = createClient(Astro.request.headers, Astro.cookies);
let dogs: Dog[] = [];
if (supabase && user) {
  dogs = await listDogs(supabase, user.id);
}

const error = Astro.url.searchParams.get("error");
const saved = Astro.url.searchParams.get("saved");
---

<Layout title={t(locale, "dogs.title")}>
  <div class="flex justify-center p-4">
    <div class="w-full max-w-lg">
      <div class="mb-6 flex items-center justify-between">
        <h1 class="text-2xl font-bold text-foreground">{t(locale, "dogs.title")}</h1>
        <a
          href="/dogs/new"
          class="rounded-lg bg-primary px-4 py-2 text-sm font-medium text-primary-foreground transition-colors hover:bg-primary/90"
        >
          {t(locale, "dogs.add")}
        </a>
      </div>

      {error ? (
        <p class="mb-4 rounded-lg border border-destructive/30 bg-destructive/10 px-3 py-2 text-sm text-destructive">
          {error}
        </p>
      ) : null}

      {saved === "1" ? (
        <p class="mb-4 rounded-lg border border-success/30 bg-success/10 px-3 py-2 text-sm text-success">
          {t(locale, "dogs.saved")}
        </p>
      ) : null}

      {dogs.length === 0 ? (
        <div class="rounded-2xl border border-border bg-card p-8 text-center text-muted-foreground">
          {t(locale, "dogs.empty")}
        </div>
      ) : (
        <ul class="space-y-3">
          {dogs.map((dog) => {
            const age = ageFromBirthdate(dog.birthdate);
            return (
              <li>
                <a
                  href={`/dogs/${dog.id}`}
                  class="flex items-center gap-4 rounded-2xl border border-border bg-card p-4 transition-colors hover:bg-accent"
                >
                  {dog.photoUrl ? (
                    <img
                      src={dog.photoUrl}
                      alt={dog.name}
                      class="size-16 rounded-full border border-border object-cover"
                    />
                  ) : (
                    <div class="flex size-16 items-center justify-center rounded-full border border-border bg-muted text-xl">
                      🐾
                    </div>
                  )}
                  <div class="min-w-0">
                    <p class="truncate font-medium text-card-foreground">{dog.name}</p>
                    <p class="truncate text-sm text-muted-foreground">{dog.breed}</p>
                    {age !== null ? (
                      <p class="text-xs text-muted-foreground">
                        {age} {t(locale, "dogs.years")}
                      </p>
                    ) : null}
                  </div>
                </a>
              </li>
            );
          })}
        </ul>
      )}
    </div>
  </div>
</Layout>
