---
import Layout from "@/layouts/Layout.astro";
import DogForm from "@/components/dogs/DogForm";
import { createClient } from "@/lib/supabase";
import { getDog } from "@/lib/services/dog";
import type { Dog } from "@/types";

const { user, locale } = Astro.locals;
const { id } = Astro.params;

const supabase = createClient(Astro.request.headers, Astro.cookies);
let dog: Dog | null = null;
if (supabase && user && id) {
  dog = await getDog(supabase, id);
}

const error = Astro.url.searchParams.get("error");
---

<Layout title="Edit dog">
  <div class="flex min-h-[80vh] items-center justify-center p-4">
    <div class="w-full max-w-sm rounded-2xl border border-border bg-card p-8 text-card-foreground">
      <h1 class="mb-6 text-center text-2xl font-bold text-foreground">Edit dog</h1>
      {dog ? (
        <Fragment>
          <DogForm dog={dog} serverError={error} locale={locale} client:load />

          <form method="POST" action={`/api/dogs/${dog.id}`} class="mt-4 text-center">
            <input type="hidden" name="_action" value="delete" />
            <button
              type="submit"
              class="text-sm text-destructive transition-colors hover:text-destructive/80 hover:underline"
            >
              Delete dog
            </button>
          </form>
        </Fragment>
      ) : (
        <p class="text-center text-muted-foreground">
          Dog not found.{" "}
          <a href="/dogs" class="text-primary hover:underline">
            Back to your dogs
          </a>
        </p>
      )}
    </div>
  </div>
</Layout>
