---
import Layout from "@/layouts/Layout.astro";
import { createClient } from "@/lib/supabase";
import { listAcceptedMeetings, listSentPending, listReceivedPending } from "@/lib/services/invitation";
import { listProfilesByIds } from "@/lib/services/profile";
import MeetingsView from "@/components/meetings/MeetingsView";
import { t } from "@/lib/i18n";
import type { Invitation, Profile } from "@/types";

const { user, locale } = Astro.locals;

const supabase = createClient(Astro.request.headers, Astro.cookies);

let meetings: Invitation[] = [];
let sentPending: Invitation[] = [];
let receivedPending: Invitation[] = [];
const profileMap = new Map<string, Profile | null>();
let errorMsg: string | null = null;

if (supabase && user) {
  try {
    [meetings, sentPending, receivedPending] = await Promise.all([
      listAcceptedMeetings(supabase, user.id),
      listSentPending(supabase, user.id),
      listReceivedPending(supabase, user.id),
    ]);

    const counterpartyIds = new Set<string>();
    for (const inv of meetings) {
      const counterpartyId = inv.senderId === user.id ? inv.receiverId : inv.senderId;
      counterpartyIds.add(counterpartyId);
    }
    for (const inv of sentPending) {
      counterpartyIds.add(inv.receiverId);
    }
    for (const inv of receivedPending) {
      counterpartyIds.add(inv.senderId);
    }

    const fetched = await listProfilesByIds(supabase, Array.from(counterpartyIds));
    for (const [id, profile] of fetched) profileMap.set(id, profile);
  } catch {
    errorMsg = t(locale, "meetings.loadError");
  }
}

const profilesObj: Record<string, { name: string }> = {};
for (const [id, p] of profileMap) {
  if (p) profilesObj[id] = { name: p.name };
}
---

<Layout title={t(locale, "meetings.title")}>
  <div class="flex justify-center p-4">
    <div class="w-full max-w-lg">
      <div class="mb-6 flex items-center justify-between">
        <h1 class="text-2xl font-bold text-foreground">{t(locale, "meetings.title")}</h1>
      </div>

      {errorMsg ? (
        <div class="rounded-2xl border border-destructive/40 bg-destructive/5 p-8 text-center text-destructive">
          {errorMsg}
        </div>
      ) : (
        <MeetingsView
          accepted={meetings}
          sentPending={sentPending}
          receivedPending={receivedPending}
          profiles={profilesObj}
          userId={user?.id ?? ""}
          locale={locale}
          client:load
        />
      )}
    </div>
  </div>
</Layout>
