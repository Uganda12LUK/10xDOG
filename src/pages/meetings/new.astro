---
import Layout from "@/layouts/Layout.astro";
import { createClient } from "@/lib/supabase";
import { getProfile } from "@/lib/services/profile";
import { listDogs } from "@/lib/services/dog";
import { getPackStatus } from "@/lib/services/pack";
import MeetingForm from "@/components/meetings/MeetingForm";
import BoneButton from "@/components/pack/BoneButton";
import { t } from "@/lib/i18n";
import type { Dog, PackStatus, Profile } from "@/types";

// /meetings is a protected route — middleware guarantees an authenticated user here.
const { user, locale } = Astro.locals;
const receiverId = Astro.url.searchParams.get("receiver_id");
const error = Astro.url.searchParams.get("error");

const supabase = createClient(Astro.request.headers, Astro.cookies);

let receiverProfile: Profile | null = null;
let myDogs: Dog[] = [];
let receiverPackStatus: PackStatus = "none";
if (supabase && user && receiverId) {
  const [fetchedProfile, fetchedDogs, status] = await Promise.all([
    getProfile(supabase, receiverId),
    listDogs(supabase, user.id),
    getPackStatus(supabase, user.id, receiverId),
  ]);
  receiverProfile = fetchedProfile;
  myDogs = fetchedDogs;
  receiverPackStatus = status;
}
---

<Layout title={t(locale, "meetingNew.title")}>
  <div class="mx-auto max-w-md p-4 lg:max-w-3xl">
    {!receiverId ? (
      <div class="rounded-2xl border border-border bg-card p-8 text-center text-card-foreground">
        <p class="text-muted-foreground">
          {t(locale, "meetingNew.noReceiver")}{" "}
          <a href="/map" class="text-primary hover:underline">
            {t(locale, "meetingNew.backToList")}
          </a>
        </p>
      </div>
    ) : receiverProfile === null ? (
      <div class="rounded-2xl border border-border bg-card p-8 text-center text-card-foreground">
        <p class="text-muted-foreground">
          {t(locale, "meetingNew.notFound")}{" "}
          <a href="/map" class="text-primary hover:underline">
            {t(locale, "meetingNew.backToList")}
          </a>
        </p>
      </div>
    ) : (
      <>
        <div class="mb-6">
          <a href={`/map/${receiverId}`} class="text-sm text-primary hover:underline">
            {t(locale, "meetingNew.backToProfile")}
          </a>
          <h1 class="mt-3 text-2xl font-bold text-foreground">
            {t(locale, "meetingNew.proposeWith")} {receiverProfile.name}
          </h1>
          {/* Add them to your pack right from here — or jump to the chat once connected. */}
          <div class="mt-3">
            <BoneButton ownerId={receiverId} status={receiverPackStatus} locale={locale} />
          </div>
        </div>
        <MeetingForm
          receiver={{
            id: receiverProfile.id,
            city: receiverProfile.city,
          }}
          dogs={myDogs}
          error={error ?? undefined}
          locale={locale}
          client:only="react"
        >
          <div slot="fallback" class="text-muted-foreground text-sm">
            {t(locale, "meetingNew.loading")}
          </div>
        </MeetingForm>
      </>
    )}
  </div>
</Layout>
