---
import Layout from "@/layouts/Layout.astro";
import ProfileForm from "@/components/profile/ProfileForm";
import { createClient } from "@/lib/supabase";
import { getProfile } from "@/lib/services/profile";
import type { Profile } from "@/types";

const { user, locale } = Astro.locals;

const supabase = createClient(Astro.request.headers, Astro.cookies);
let profile: Profile | null = null;
if (supabase && user) {
  profile = await getProfile(supabase, user.id);
}

const error = Astro.url.searchParams.get("error");
const saved = Astro.url.searchParams.get("saved");
const onboarding = Astro.url.searchParams.get("onboarding");
---

<Layout title="Your profile">
  <div class="flex min-h-[80vh] items-center justify-center p-4">
    <div class="w-full max-w-sm rounded-2xl border border-border bg-card p-8 text-card-foreground">
      <h1 class="mb-6 text-center text-2xl font-bold text-foreground">Your profile</h1>
      <ProfileForm
        profile={profile}
        serverError={error}
        saved={saved === "1"}
        onboarding={onboarding === "1"}
        locale={locale}
        client:load
      />
      <a
        href="/dogs"
        class="mt-4 block text-center text-sm text-primary transition-colors hover:text-primary/80 hover:underline"
      >
        Your dogs →
      </a>
    </div>
  </div>
</Layout>
