---
import Layout from "@/layouts/Layout.astro";
import { createClient } from "@/lib/supabase";
import { listOwners, getProfile } from "@/lib/services/profile";
import OwnersMapView from "@/components/map/OwnersMapView";
import type { OwnerWithDogs } from "@/types";

const { user } = Astro.locals;

const supabase = createClient(Astro.request.headers, Astro.cookies);

let owners: OwnerWithDogs[] = [];
let myCity: string | null = null;
let hasCity = false;

if (supabase && user) {
  const profile = await getProfile(supabase, user.id);
  myCity = profile?.city ?? null;
  hasCity = myCity != null && myCity.length > 0;

  if (hasCity && myCity) {
    const myDistrict = profile?.district ?? null;

    if (myDistrict) {
      owners = await listOwners(supabase, user.id, myCity, myDistrict);
      if (owners.length === 0) {
        owners = await listOwners(supabase, user.id, myCity);
      }
    } else {
      owners = await listOwners(supabase, user.id, myCity);
    }
  }
}
---

<Layout title="Mapa spacerów">
  {!hasCity ? (
    <div class="flex justify-center p-4">
      <div class="w-full max-w-lg">
        <div class="rounded-2xl border border-border bg-card p-8 text-center text-muted-foreground">
          Set your city in{" "}
          <a href="/profile" class="text-primary hover:underline">
            Profile
          </a>{" "}
          to see local owners.
        </div>
      </div>
    </div>
  ) : (
    <OwnersMapView owners={owners} city={myCity ?? ""} client:only="react" />
  )}
</Layout>
