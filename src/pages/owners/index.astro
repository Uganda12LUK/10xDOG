---
import Layout from "@/layouts/Layout.astro";
import { createClient } from "@/lib/supabase";
import { listOwners, getProfile } from "@/lib/services/profile";
import type { OwnerWithDogs } from "@/types";

const { user } = Astro.locals;

const supabase = createClient(Astro.request.headers, Astro.cookies);

let owners: OwnerWithDogs[] = [];
let showingCityWide = false;
let myCity: string | null = null;
let hasCity = false;

if (supabase && user) {
  const profile = await getProfile(supabase, user.id);
  myCity = profile?.city ?? null;
  hasCity = myCity != null && myCity.length > 0;

  if (hasCity && myCity) {
    const myDistrict = profile?.district ?? null;

    if (myDistrict) {
      owners = await listOwners(supabase, user.id, myCity, myDistrict);
      if (owners.length === 0) {
        owners = await listOwners(supabase, user.id, myCity);
        showingCityWide = true;
      }
    } else {
      owners = await listOwners(supabase, user.id, myCity);
    }
  }
}
---

<Layout title="Owners near you">
  <div class="flex justify-center p-4">
    <div class="w-full max-w-lg text-white">
      <div class="mb-6 flex items-center justify-between">
        <h1 class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-2xl font-bold text-transparent">
          Owners near you
        </h1>
      </div>

      {!hasCity ? (
        <div class="rounded-2xl border border-white/10 bg-white/10 p-8 text-center text-blue-100/80 backdrop-blur-xl">
          Set your city in{" "}
          <a href="/profile" class="text-purple-300 hover:underline">
            Profile
          </a>{" "}
          to see local owners.
        </div>
      ) : (
        <>
          {showingCityWide ? (
            <p class="mb-4 rounded-lg border border-blue-500/30 bg-blue-900/30 px-3 py-2 text-sm text-blue-200">
              No owners in your district yet — showing all owners in {myCity}
            </p>
          ) : null}

          {owners.length === 0 ? (
            <div class="rounded-2xl border border-white/10 bg-white/10 p-8 text-center text-blue-100/80 backdrop-blur-xl">
              No other owners found in {myCity} yet.{" "}
              <a href="/profile" class="text-purple-300 hover:underline">
                Update your profile
              </a>
            </div>
          ) : (
            <ul class="space-y-3">
              {owners.map(({ profile, dogs }) => (
                <li>
                  <a
                    href={`/owners/${profile.id}`}
                    class="flex items-center gap-4 rounded-2xl border border-white/10 bg-white/10 p-4 backdrop-blur-xl transition-colors hover:bg-white/15"
                  >
                    {profile.avatarUrl ? (
                      <img
                        src={profile.avatarUrl}
                        alt={profile.name}
                        class="size-16 rounded-full border border-white/20 object-cover"
                      />
                    ) : (
                      <div class="flex size-16 items-center justify-center rounded-full border border-white/20 bg-white/10 text-xl">
                        🐾
                      </div>
                    )}
                    <div class="min-w-0 flex-1">
                      <p class="truncate font-medium text-white">{profile.name}</p>
                      <p class="truncate text-sm text-blue-100/70">
                        {profile.district ? `${profile.district}, ${profile.city}` : profile.city}
                      </p>
                      {dogs.length > 0 ? (
                        <p class="mt-1 truncate text-xs text-blue-100/60">
                          {dogs.map((d) => `• ${d.name} (${d.breed})`).join("  ")}
                        </p>
                      ) : null}
                    </div>
                  </a>
                </li>
              ))}
            </ul>
          )}
        </>
      )}
    </div>
  </div>
</Layout>
