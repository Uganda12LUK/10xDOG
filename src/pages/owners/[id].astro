---
import Layout from "@/layouts/Layout.astro";
import { createClient } from "@/lib/supabase";
import { getProfile } from "@/lib/services/profile";
import { listDogs } from "@/lib/services/dog";
import { hasPendingInvitation } from "@/lib/services/invitation";
import type { Dog, Profile } from "@/types";

const { user } = Astro.locals;
const { id } = Astro.params;

const supabase = createClient(Astro.request.headers, Astro.cookies);

let profile: Profile | null = null;
let dogs: Dog[] = [];
let pendingInvitation = false;
const isOwnProfile = user && id ? id === user.id : false;
const ownerId = id ?? "";

if (supabase && id && !isOwnProfile) {
  profile = await getProfile(supabase, id);
  if (profile) {
    dogs = await listDogs(supabase, id);
    if (user) {
      pendingInvitation = await hasPendingInvitation(supabase, user.id, id);
    }
  }
}

const sent = Astro.url.searchParams.get("sent");
const error = Astro.url.searchParams.get("error");
---

<Layout title={profile?.name ?? "Owner"}>
  <div class="flex min-h-[80vh] items-center justify-center p-4">
    {isOwnProfile ? (
      <div class="w-full max-w-sm rounded-2xl border border-border bg-card p-8 text-center text-card-foreground">
        <p class="text-muted-foreground">
          This is your profile.{" "}
          <a href="/profile" class="text-primary hover:underline">
            Go to your profile
          </a>
        </p>
      </div>
    ) : profile ? (
      <div class="w-full max-w-sm rounded-2xl border border-border bg-card p-8 text-card-foreground">
        <div class="mb-6 flex flex-col items-center gap-3">
          {profile.avatarUrl ? (
            <img
              src={profile.avatarUrl}
              alt={profile.name}
              class="size-24 rounded-full border border-border object-cover"
            />
          ) : (
            <div class="flex size-24 items-center justify-center rounded-full border border-border bg-muted text-3xl">
              🐾
            </div>
          )}
          <h1 class="text-center text-2xl font-bold text-foreground">{profile.name}</h1>
          {profile.district || profile.city ? (
            <p class="text-center text-sm text-muted-foreground">
              {profile.district ? `${profile.district}, ${profile.city}` : profile.city}
            </p>
          ) : null}
        </div>

        {dogs.length > 0 ? (
          <div class="mb-6">
            <h2 class="mb-2 text-sm font-medium text-muted-foreground">Dogs</h2>
            <ul class="space-y-2">
              {dogs.map((dog) => (
                <li class="flex items-center gap-3 rounded-xl border border-border bg-muted px-3 py-2">
                  {dog.photoUrl ? (
                    <img
                      src={dog.photoUrl}
                      alt={dog.name}
                      class="size-8 rounded-full border border-border object-cover"
                    />
                  ) : (
                    <div class="flex size-8 items-center justify-center rounded-full border border-border bg-background text-xs">
                      🐾
                    </div>
                  )}
                  <div class="min-w-0">
                    <p class="truncate text-sm font-medium text-foreground">{dog.name}</p>
                    <p class="truncate text-xs text-muted-foreground">{dog.breed}</p>
                  </div>
                </li>
              ))}
            </ul>
          </div>
        ) : null}

        {sent === "1" ? (
          <div class="mt-4 rounded-lg border border-success/30 bg-success/10 px-3 py-2 text-sm text-success">
            Walk invitation sent!
          </div>
        ) : null}
        {error ? (
          <div class="mt-4 rounded-lg border border-destructive/30 bg-destructive/10 px-3 py-2 text-sm text-destructive">
            {error}
          </div>
        ) : null}

        {pendingInvitation ? (
          <button
            disabled
            class="mt-6 w-full cursor-not-allowed rounded-lg bg-muted px-4 py-2 text-sm font-medium text-muted-foreground"
          >
            Invitation sent — awaiting response
          </button>
        ) : (
          <a
            href={`/meetings/new?receiver_id=${ownerId}`}
            class="mt-6 block w-full rounded-lg bg-primary px-4 py-2 text-center text-sm font-medium text-primary-foreground transition-opacity hover:opacity-90"
          >
            Zaproponuj spotkanie
          </a>
        )}

        <div class="mt-4 text-center">
          <a href="/owners" class="text-sm text-primary hover:underline">
            ← Back to owners
          </a>
        </div>
      </div>
    ) : (
      <div class="w-full max-w-sm rounded-2xl border border-border bg-card p-8 text-center text-card-foreground">
        <p class="text-muted-foreground">
          Owner not found.{" "}
          <a href="/owners" class="text-primary hover:underline">
            ← Back to owners
          </a>
        </p>
      </div>
    )}
  </div>
</Layout>
