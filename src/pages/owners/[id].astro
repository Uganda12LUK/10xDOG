---
import Layout from "@/layouts/Layout.astro";
import { createClient } from "@/lib/supabase";
import { getProfile } from "@/lib/services/profile";
import { listDogs } from "@/lib/services/dog";
import { hasPendingInvitation } from "@/lib/services/invitation";
import type { Dog, Profile } from "@/types";

const { user } = Astro.locals;
const { id } = Astro.params;

const supabase = createClient(Astro.request.headers, Astro.cookies);

let profile: Profile | null = null;
let dogs: Dog[] = [];
let pendingInvitation = false;
const isOwnProfile = user && id ? id === user.id : false;
const ownerId = id ?? "";

if (supabase && id && !isOwnProfile) {
  profile = await getProfile(supabase, id);
  if (profile) {
    dogs = await listDogs(supabase, id);
    if (user) {
      pendingInvitation = await hasPendingInvitation(supabase, user.id, id);
    }
  }
}

const sent = Astro.url.searchParams.get("sent");
const error = Astro.url.searchParams.get("error");
---

<Layout title={profile?.name ?? "Owner"}>
  <div class="flex min-h-[80vh] items-center justify-center p-4">
    {isOwnProfile ? (
      <div class="w-full max-w-sm rounded-2xl border border-white/10 bg-white/10 p-8 text-center text-white backdrop-blur-xl">
        <p class="text-blue-100/80">
          This is your profile.{" "}
          <a href="/profile" class="text-purple-300 hover:underline">
            Go to your profile
          </a>
        </p>
      </div>
    ) : profile ? (
      <div class="w-full max-w-sm rounded-2xl border border-white/10 bg-white/10 p-8 text-white backdrop-blur-xl">
        <div class="mb-6 flex flex-col items-center gap-3">
          {profile.avatarUrl ? (
            <img
              src={profile.avatarUrl}
              alt={profile.name}
              class="size-24 rounded-full border border-white/20 object-cover"
            />
          ) : (
            <div class="flex size-24 items-center justify-center rounded-full border border-white/20 bg-white/10 text-3xl">
              🐾
            </div>
          )}
          <h1 class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-center text-2xl font-bold text-transparent">
            {profile.name}
          </h1>
          {profile.district || profile.city ? (
            <p class="text-center text-sm text-blue-100/70">
              {profile.district ? `${profile.district}, ${profile.city}` : profile.city}
            </p>
          ) : null}
        </div>

        {dogs.length > 0 ? (
          <div class="mb-6">
            <h2 class="mb-2 text-sm font-medium text-blue-100/70">Dogs</h2>
            <ul class="space-y-2">
              {dogs.map((dog) => (
                <li class="flex items-center gap-3 rounded-xl border border-white/10 bg-white/5 px-3 py-2">
                  {dog.photoUrl ? (
                    <img
                      src={dog.photoUrl}
                      alt={dog.name}
                      class="size-8 rounded-full border border-white/20 object-cover"
                    />
                  ) : (
                    <div class="flex size-8 items-center justify-center rounded-full border border-white/20 bg-white/10 text-xs">
                      🐾
                    </div>
                  )}
                  <div class="min-w-0">
                    <p class="truncate text-sm font-medium text-white">{dog.name}</p>
                    <p class="truncate text-xs text-blue-100/60">{dog.breed}</p>
                  </div>
                </li>
              ))}
            </ul>
          </div>
        ) : null}

        {sent === "1" ? (
          <div class="mt-4 rounded-lg border border-green-500/30 bg-green-900/30 px-3 py-2 text-sm text-green-200">
            Walk invitation sent!
          </div>
        ) : null}
        {error ? (
          <div class="mt-4 rounded-lg border border-red-500/30 bg-red-900/30 px-3 py-2 text-sm text-red-200">
            {error}
          </div>
        ) : null}

        {pendingInvitation ? (
          <button
            disabled
            class="mt-6 w-full cursor-not-allowed rounded-lg bg-purple-600/50 px-4 py-2 text-sm font-medium text-white/50"
          >
            Invitation sent — awaiting response
          </button>
        ) : (
          <form method="POST" action="/api/invitations" class="mt-6">
            <input type="hidden" name="receiver_id" value={ownerId} />
            <input type="hidden" name="type" value="walk" />
            <button
              type="submit"
              class="w-full rounded-lg bg-gradient-to-r from-purple-600 to-blue-600 px-4 py-2 text-sm font-medium text-white transition-opacity hover:opacity-90"
            >
              Send walk invitation
            </button>
          </form>
        )}

        <div class="mt-4 text-center">
          <a href="/owners" class="text-sm text-purple-300 hover:underline">
            ← Back to owners
          </a>
        </div>
      </div>
    ) : (
      <div class="w-full max-w-sm rounded-2xl border border-white/10 bg-white/10 p-8 text-center text-white backdrop-blur-xl">
        <p class="text-blue-100/80">
          Owner not found.{" "}
          <a href="/owners" class="text-purple-300 hover:underline">
            ← Back to owners
          </a>
        </p>
      </div>
    )}
  </div>
</Layout>
