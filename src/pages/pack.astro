---
import Layout from "@/layouts/Layout.astro";
import PackView from "@/components/pack/PackView";
import { createClient } from "@/lib/supabase";
import { listPack, listPendingReceived } from "@/lib/services/pack";
import { t } from "@/lib/i18n";
import type { PackMember } from "@/types";

const { user, locale } = Astro.locals;
const supabase = createClient(Astro.request.headers, Astro.cookies);

let requests: PackMember[] = [];
let members: PackMember[] = [];

if (supabase && user) {
  [requests, members] = await Promise.all([listPendingReceived(supabase, user.id), listPack(supabase, user.id)]);
}
---

<Layout title={t(locale, "pack.title")}>
  <div class="mx-auto w-full max-w-2xl px-4 py-6">
    <h1 class="text-foreground mb-6 flex items-center gap-2 text-2xl font-bold">
      <span aria-hidden="true">🦴</span>
      {t(locale, "pack.title")}
    </h1>
    <PackView initialRequests={requests} initialMembers={members} locale={locale} client:load />
  </div>
</Layout>
