---
import "../styles/global.css";
import Banner from "@/components/Banner.astro";
import BottomNav from "@/components/BottomNav.astro";
import Topbar from "@/components/Topbar.astro";
import { missingConfigs } from "@/lib/config-status";
import { createClient } from "@/lib/supabase";
import { countUnread } from "@/lib/services/chat";
import { countPendingReceived } from "@/lib/services/pack";

interface Props {
  title?: string;
}

const { title = "PawMeet" } = Astro.props;
const { user, locale } = Astro.locals;

// Pack nav badge, computed once here and shared by both the mobile (BottomNav)
// and desktop (Topbar) navs so the "something waiting in Pack" signal shows on
// every view. It sums unread messages and pending bone requests — both are
// actioned on /pack. SSR-only: refreshes on navigation, not live.
let packBadge = 0;
if (user) {
  const supabase = createClient(Astro.request.headers, Astro.cookies);
  if (supabase) {
    try {
      const [unread, bones] = await Promise.all([
        countUnread(supabase, user.id),
        countPendingReceived(supabase, user.id),
      ]);
      packBadge = unread + bones;
    } catch {
      packBadge = 0;
    }
  }
}
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,400;0,14..32,500;0,14..32,600;0,14..32,700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body>
    {missingConfigs.map((cfg) => (
      <Banner variant="error">
        <strong>Uwaga:</strong> {cfg.message}
        {cfg.docsUrl && (
          <>
            {" "}
            <a href={cfg.docsUrl} target="_blank" rel="noopener noreferrer">
              {cfg.docsLabel ?? "Dokumentacja"}
            </a>
            .
          </>
        )}
      </Banner>
    ))}
    <div class:list={["bg-background min-h-screen", { "max-md:pb-[70px]": !!user }]}>
      {/* Topbar is desktop-only (md:flex). Hide its padded wrapper on mobile so it
          doesn't leave an empty strip pushing content (e.g. the map) below the fold. */}
      <div class="hidden p-4 md:block">
        <Topbar currentPath={Astro.url.pathname} packBadge={packBadge} />
      </div>
      <slot />
    </div>
    {user && <BottomNav currentPath={Astro.url.pathname} packBadge={packBadge} />}
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
