# Normalize line endings: store LF in the repo and check out LF everywhere,
# so Prettier/ESLint behave the same on Windows, macOS, Linux, and CI.
* text=auto eol=lf

# Binary assets — never normalize.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
